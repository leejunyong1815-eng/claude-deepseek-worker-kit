#!/usr/bin/env bash
# remote-sync — 현재 프로젝트를 원격 노드의 <COMPUTE_WORK_DIR>/<프로젝트> 로 동기화 (로컬이 원본).
set -euo pipefail
# shellcheck disable=SC1091
source "$(dirname "$(readlink -f "$0")")/remote-common.sh"
echo "[remote] project : $PROJECT"
echo "[remote] source  : $ROOT"
echo "[remote] target  : $COMPUTE_HOST:$REMOTE_ROOT"
"${SSH[@]}" "mkdir -p -- $(remote_quote "$REMOTE_ROOT") $(remote_quote "$REMOTE_ROOT/outputs")"
EXCLUDES=(--exclude '.git' --exclude '.venv/' --exclude 'venv/' --exclude 'node_modules/'
          --exclude '__pycache__/' --exclude '.cache/' --exclude 'outputs/')
[ -f "$ROOT/.remoteignore" ] && EXCLUDES+=(--exclude-from "$ROOT/.remoteignore")
# Keep remote artifacts and stale files; automatic deletion is never implied.
rsync -az -s -e "$RSYNC_SSH" "${EXCLUDES[@]}" "$ROOT/" "$COMPUTE_HOST:$REMOTE_ROOT/"
echo "[remote] sync complete"
