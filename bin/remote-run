#!/usr/bin/env bash
# remote-run "<command>" — 동기화 → 원격 프로젝트 디렉터리에서 실행 → outputs/ 회수.
set -euo pipefail
[ "$#" -ge 1 ] || { echo 'Usage: remote-run "command"' >&2; exit 2; }
# shellcheck disable=SC1091
source "$(dirname "$(readlink -f "$0")")/remote-common.sh"
CMD="$*"
remote-sync
echo; echo "[remote] executing on $COMPUTE_HOST:"; echo "$CMD"; echo
set +e
"${SSH[@]}" "cd $(printf '%q' "$REMOTE_ROOT") && bash -lc $(printf '%q' "$CMD")"
STATUS=$?
set -e
mkdir -p "$ROOT/outputs"
rsync -az "$COMPUTE_HOST:$REMOTE_ROOT/outputs/" "$ROOT/outputs/" 2>/dev/null || true
echo; echo "[remote] exit status: $STATUS"
exit "$STATUS"
