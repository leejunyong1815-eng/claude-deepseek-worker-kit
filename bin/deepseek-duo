#!/usr/bin/env bash
# deepseek-duo — tmux 한 창에 오케스트레이터(왼쪽) + 로컬 LLM 워커(오른쪽)를 띄운다.
# 사용: deepseek-duo [-w N] [-P 프로필[,프로필…]] [프로젝트 디렉터리]   (기본: 현재 디렉터리, 기본 워커 1개)
#       -w N              기본 프로필 워커를 N개. 이름 <WORKER_NAME>-1 … -N  (N=1 이면 <WORKER_NAME>)
#       -P review           프로필 워커를 추가로 하나씩 (env.<프로필> 사용). 예: -P review
#       deepseek-duo --kill 세션 종료
set -euo pipefail

SESSION="${DEEPSEEK_DUO_SESSION:-deepseek-duo}"
CONF_DIR="${DEEPSEEK_WORKER_CONF_DIR:-$HOME/.config/deepseek-worker}"
N=1; PROFILES=""

while [ $# -gt 0 ]; do
    case "$1" in
        --kill) tmux kill-session -t "$SESSION" 2>/dev/null && echo "종료: $SESSION" || echo "세션 없음: $SESSION"; exit 0 ;;
        -w|--workers) N="$2"; shift 2 ;;
        -P|--profile|--profiles) PROFILES="$2"; shift 2 ;;
        -h|--help) sed -n '2,6p' "$0"; exit 0 ;;
        *) DIR="$1"; shift ;;
    esac
done
[[ "$N" =~ ^[0-9][0-9]?$ ]] || { echo "워커 수는 0~99: $N" >&2; exit 2; }

DIR="$(cd "${DIR:-$PWD}" && pwd)"
command -v tmux >/dev/null 2>&1 || { echo "tmux 가 필요합니다 (sudo apt install tmux)." >&2; exit 2; }
[ -f "$CONF_DIR/env" ] || { echo "설정 파일이 없습니다: $CONF_DIR/env — install.sh 를 먼저 실행하세요." >&2; exit 2; }
name_of() { # name_of <env파일> <기본이름>
    # shellcheck disable=SC1090
    (source "$1" && printf '%s' "${WORKER_NAME:-$2}")
}
WORKER_BASE="$(name_of "$CONF_DIR/env" deepseek-worker)"

if tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "이미 실행 중: tmux attach -t $SESSION   (끝내려면 deepseek-duo --kill)"
    exec tmux attach -t "$SESSION"
fi

# 워커 목록: "<표시이름>|<명령>"
PANES=()
if [ "$N" -eq 1 ]; then
    PANES+=("@$WORKER_BASE|deepseek-worker")
elif [ "$N" -gt 1 ]; then
    for i in $(seq 1 "$N"); do PANES+=("@$WORKER_BASE-$i|DEEPSEEK_WORKER_NAME=$WORKER_BASE-$i deepseek-worker"); done
fi
IFS=',' read -r -a PLIST <<< "$PROFILES"
for p in "${PLIST[@]}"; do
    [ -n "$p" ] || continue
    [ -f "$CONF_DIR/env.$p" ] || { echo "프로필 설정이 없습니다: $CONF_DIR/env.$p — install.sh --profile $p" >&2; exit 2; }
    PANES+=("@$(name_of "$CONF_DIR/env.$p" "deepseek-worker-$p")|deepseek-worker -P $p")
done
[ "${#PANES[@]}" -ge 1 ] || { echo "워커가 하나도 없습니다 (-w 0 이면 -P 가 필요)" >&2; exit 2; }

COLS="$(tput cols 2>/dev/null || echo 200)"; LINES="$(tput lines 2>/dev/null || echo 50)"
[ "$COLS" -ge 120 ] || COLS=200; [ "$LINES" -ge 30 ] || LINES=50
tmux new-session -d -s "$SESSION" -c "$DIR" -n main -x "$COLS" -y "$LINES" "deepseek-main; exec bash"
NAMES=""; first=1
for entry in "${PANES[@]}"; do
    label="${entry%%|*}"; cmd="${entry#*|}"; NAMES="$NAMES $label"
    if [ $first -eq 1 ]; then tmux split-window -h -t "$SESSION:main" -c "$DIR" "$cmd; exec bash"; first=0
    else tmux split-window -v -t "$SESSION:main" -c "$DIR" "$cmd; exec bash"; fi
done
if [ "${#PANES[@]}" -gt 1 ]; then
    tmux set-window-option -t "$SESSION:main" main-pane-width "$((COLS / 2))"
    tmux select-layout -t "$SESSION:main" main-vertical
fi
tmux select-pane -t "$SESSION:main.0"
echo "워커:$NAMES   (tmux: Ctrl-b 화살표로 창 이동, Ctrl-b d 로 떼기)"
sleep 1
exec tmux attach -t "$SESSION"
