#!/usr/bin/env bash
# remote-submit JOB_NAME "<command>" — 원격 tmux 세션에서 장시간 작업 실행. 로그는 outputs/<JOB>.log.
set -euo pipefail
[ "$#" -ge 2 ] || { echo 'Usage: remote-submit JOB_NAME "command"' >&2; exit 2; }
JOB="$1"; shift; CMD="$*"
[[ "$JOB" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "Invalid job name: $JOB" >&2; exit 2; }
# shellcheck disable=SC1091
source "$(dirname "$(readlink -f "$0")")/remote-common.sh"
"$REMOTE_BIN/remote-sync"
SESSION="lw-$REMOTE_NAMESPACE-${JOB//./_}"
SCRIPT="$REMOTE_ROOT/.jobs/$JOB.sh"
LOG="$REMOTE_ROOT/outputs/$JOB.log"
{
    echo '#!/usr/bin/env bash'; echo 'set -o pipefail'
    printf 'cd -- %s\n' "$(remote_quote "$REMOTE_ROOT")"; printf '%s\n' "$CMD"
} | "${SSH[@]}" "
    if tmux has-session -t $(remote_quote "$SESSION") 2>/dev/null; then echo 'remote: job session already exists' >&2; exit 1; fi
    mkdir -p -- $(remote_quote "$REMOTE_ROOT/.jobs") $(remote_quote "$REMOTE_ROOT/outputs") &&
    cat > $(remote_quote "$SCRIPT") && chmod +x -- $(remote_quote "$SCRIPT") &&
    tmux new-session -d -s $(remote_quote "$SESSION") $(remote_quote "bash $(remote_quote "$SCRIPT") > $(remote_quote "$LOG") 2>&1") &&
    printf '%s\n' $(remote_quote "Started: $SESSION") $(remote_quote "Log: $LOG")
"
