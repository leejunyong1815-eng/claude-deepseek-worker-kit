#!/usr/bin/env bash
# llm-worker — 로컬 LLM 서버에 연결된 Claude Code 워커 세션.
# 사용: llm-worker [-P 프로필] [claude 인자...]
#   설정: ~/.config/local-worker/env            (기본 프로필)
#         ~/.config/local-worker/env.<프로필>    (-P <프로필>, 예: -P review)
#   연결은 gateway.env 하나를 공유하고 프로필마다 모델·역할·워커 이름을 둔다.
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/_kit_env.sh"

CONF_DIR="${LLM_WORKER_CONF_DIR:-$HOME/.config/local-worker}"
if [ "${1:-}" = serve ] || [ "${1:-}" = list ] || [ "${1:-}" = stop ]; then
    exec python3 "$(dirname "$(readlink -f "$0")")/_worker_pool.py" "$@"
fi
PROFILE="${LLM_WORKER_PROFILE:-}"
BACKEND="${LLM_WORKER_BACKEND:-}"
MODEL="${LLM_WORKER_MODEL:-}"
while [ $# -gt 0 ]; do
    case "$1" in
        -P|--profile) [ $# -ge 2 ] || exit 2; PROFILE="$2"; shift 2 ;;
        -B|--backend|--model)
            [ "${LLM_TASK_MANAGED:-0}" != 1 ] || { echo 'managed routing override refused' >&2; exit 2; }
            [ $# -ge 2 ] || exit 2
            if [ "$1" = --model ]; then MODEL="$2"; else BACKEND="$2"; fi
            shift 2 ;;
        *) break ;;
    esac
done
[[ -z "$PROFILE" || "$PROFILE" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "invalid profile" >&2; exit 2; }
ENV_FILE="$CONF_DIR/env${PROFILE:+.$PROFILE}"
PROMPT_FILE="$CONF_DIR/worker${PROFILE:+.$PROFILE}.md"

if [ ! -f "$ENV_FILE" ]; then
    echo "llm-worker: 설정 파일이 없습니다: $ENV_FILE" >&2
    if [ -n "$PROFILE" ]; then echo "  install.sh --profile $PROFILE 로 만드세요." >&2
    else echo "  install.sh 를 먼저 실행하세요." >&2; fi
    exit 2
fi
# shellcheck disable=SC1090
source "$ENV_FILE"
# Registered server/model choice is independent of display names and role prompts.
BACKEND_ENV="$(python3 "$(dirname "$(readlink -f "$0")")/_backends.py" "$PROFILE" "$BACKEND" "$MODEL")" || exit 2
eval "$BACKEND_ENV"
unset BACKEND_ENV

: "${LLM_BASE_URL:?LLM_BASE_URL 이 비어 있습니다 ($ENV_FILE)}"
case "${LLM_AUTH_MODE:-api_key}" in
    api_key) : "${LLM_API_KEY:?LLM_API_KEY is required}"; WORKER_AUTH_TOKEN="$LLM_API_KEY" ;;
    none) WORKER_AUTH_TOKEN="litellm-no-auth" ;; # Client-side token only; the proxy is explicitly keyless.
    *) echo 'invalid LLM_AUTH_MODE' >&2; exit 2 ;;
esac
: "${LLM_MODEL:?LLM_MODEL 이 비어 있습니다 ($ENV_FILE)}"
: "${LLM_CONTEXT_WINDOW:?LLM_CONTEXT_WINDOW is required}"
[[ "$LLM_CONTEXT_WINDOW" =~ ^[1-9][0-9]*$ ]] || { echo 'invalid context limit' >&2; exit 2; }
for value in "$LLM_BASE_URL" "$WORKER_AUTH_TOKEN" "$LLM_MODEL"; do
    [[ "$value" != *CHANGE_ME* && "$value" != none && "$value" != dummy ]] || { echo 'lab backend is unconfigured' >&2; exit 2; }
done
ROLE="${LLM_WORKER_ROLE:-${WORKER_ROLE:-implementer}}"
[ "$ROLE" != impl ] || ROLE=implementer
[ -n "$ROLE" ] || ROLE=implementer
case "$ROLE" in planner|researcher|implementer|test-author|runner|analyst|reviewer|compute-runner) ;; *) echo 'invalid worker role' >&2; exit 2;; esac
# Managed specs are immutable; prevent trailing CLI arguments overriding routing and permissions.
if [ "${LLM_TASK_MANAGED:-0}" = 1 ]; then
    for arg in "$@"; do
        case "$arg" in --effort|--effort=*|--model|--model=*|--settings|--settings=*|--permission-mode|--permission-mode=*|--tools|--tools=*|--allowedTools|--allowedTools=*|--disallowedTools|--disallowedTools=*|--dangerously-skip-permissions|--allow-dangerously-skip-permissions) echo 'managed model/effort/permission override refused' >&2; exit 2;; esac
    done
fi
# 셸의 LLM_WORKER_NAME 이 설정 파일의 WORKER_NAME 보다 우선한다 (워커를 여러 개 띄울 때).
WORKER_NAME="${LLM_WORKER_NAME:-${WORKER_NAME:-llm-worker${PROFILE:+-$PROFILE}}}"

case "$LLM_BASE_URL" in
    */v1|*/v1/) echo "llm-worker: LLM_BASE_URL 끝의 /v1 을 떼세요 (Claude Code 가 /v1/messages 를 붙입니다): $LLM_BASE_URL" >&2; exit 2 ;;
esac

ROLE_FILE="$CONF_DIR/roles/role-$ROLE.md"
if [ ! -f "$ROLE_FILE" ]; then
    KIT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
    ROLE_FILE="$KIT/prompts/role-$ROLE.md.tmpl"
fi
[ -f "$ROLE_FILE" ] || { echo 'role prompt missing; run install.sh --update/--render' >&2; exit 2; }
BASE_PROMPT=""
[ ! -f "$PROMPT_FILE" ] || BASE_PROMPT="$(cat "$PROMPT_FILE")"
APPEND=(--append-system-prompt "Active worker: $WORKER_NAME. Backend: $LLM_ACTIVE_BACKEND. Model: $LLM_MODEL.
$BASE_PROMPT
$(cat "$ROLE_FILE")")

# Managed permission rules are generated outside the worktree by the runner.
SETTINGS=(--settings '{"crossSessionInbound":"accept"}')
TOOLS=()
if [ "${LLM_TASK_MANAGED:-0}" = 1 ] && [ -n "${LLM_WORKER_SETTINGS:-}" ]; then
    [ -f "$LLM_WORKER_SETTINGS" ] || { echo 'managed permission settings missing' >&2; exit 2; }
    SETTINGS=(--settings "$LLM_WORKER_SETTINGS")
    TOOLS=(--tools default)
fi

# Legacy profile/task effort values are ignored; let Claude and the backend choose defaults.
# 모든 모델 계층(opus/sonnet/haiku/fable, 서브에이전트)을 같은 로컬 모델로 묶는다.
# 그래야 제목 생성 등 백그라운드 호출이 서버가 모르는 모델명으로 나가지 않는다.
exec env \
  -u ANTHROPIC_API_KEY \
  -u CLAUDE_CODE_USE_BEDROCK \
  -u CLAUDE_CODE_USE_VERTEX \
  -u CLAUDE_CODE_USE_FOUNDRY \
  -u MAX_THINKING_TOKENS \
  -u CLAUDE_CODE_DISABLE_EXPLORE_PLAN_AGENTS \
  -u CLAUDE_AGENT_SDK_DISABLE_BUILTIN_AGENTS \
  -u LLM_MAIN_MANAGED_DELEGATION \
  -u CLAUDE_CODE_EFFORT_LEVEL \
  -u LLM_WORKER_EFFORT \
  -u LLM_EFFORT \
  -u ANTHROPIC_SMALL_FAST_MODEL \
  -u CLAUDE_CODE_AUTO_COMPACT_WINDOW \
  -u CLAUDE_CODE_MAX_OUTPUT_TOKENS \
  -u CLAUDE_CODE_WORKFLOW_SUBAGENT_MODEL \
  ANTHROPIC_BASE_URL="$LLM_BASE_URL" \
  ANTHROPIC_AUTH_TOKEN="$WORKER_AUTH_TOKEN" \
  ANTHROPIC_MODEL="$LLM_MODEL" \
  ANTHROPIC_DEFAULT_OPUS_MODEL="$LLM_MODEL" \
  ANTHROPIC_DEFAULT_SONNET_MODEL="$LLM_MODEL" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="$LLM_MODEL" \
  ANTHROPIC_DEFAULT_FABLE_MODEL="$LLM_MODEL" \
  CLAUDE_CODE_SUBAGENT_MODEL="$LLM_MODEL" \
  CLAUDE_CODE_SUBAGENT_MODEL_FORCE=1 \
  CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
  CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS="${LLM_DISABLE_BETAS:-1}" \
  DISABLE_PROMPT_CACHING="${LLM_DISABLE_PROMPT_CACHING:-0}" \
  ${LLM_CONTEXT_WINDOW:+CLAUDE_CODE_MAX_CONTEXT_TOKENS="$LLM_CONTEXT_WINDOW"} \
  ${LLM_CAPABILITIES:+ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES="$LLM_CAPABILITIES"} \
  ${LLM_CAPABILITIES:+ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES="$LLM_CAPABILITIES"} \
  ${LLM_CAPABILITIES:+ANTHROPIC_DEFAULT_HAIKU_MODEL_SUPPORTED_CAPABILITIES="$LLM_CAPABILITIES"} \
  ${LLM_CAPABILITIES:+ANTHROPIC_DEFAULT_FABLE_MODEL_SUPPORTED_CAPABILITIES="$LLM_CAPABILITIES"} \
  ANTHROPIC_DEFAULT_OPUS_MODEL_NAME="$LLM_MODEL (local)" \
  claude \
    --model "$LLM_MODEL" \
    --name "$WORKER_NAME" \
    "${SETTINGS[@]}" \
    "${TOOLS[@]}" \
    "${APPEND[@]}" \
    "$@"
