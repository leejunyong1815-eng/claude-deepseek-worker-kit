# ~/.config/claude-worker/env  — 로컬 LLM 워커 설정 (chmod 600)
# install.sh 가 이 파일을 만든다. 직접 고쳐도 된다. 쉘 문법(export KEY=value).
#
# 프로필: 같은 디렉터리의 env.<이름> 은 두 번째 워커 설정이다 (claude-worker -P <이름>).
#   연구실 기본 구성 = env (LiteLLM :4000 의 qwen3.8-flash-next, GB10 우선) + env.impl (같은 모델, 구현 전용 프롬프트) [+ env.vega (같은 LiteLLM 의 qwen3.6-35b-a3b, 느림)]
#   프로필은 LLM_* 와 WORKER_NAME 만 다르고 COMPUTE_* 는 보통 같다.

# ── LLM 서버 ─────────────────────────────────────────────────────────────
# Anthropic Messages API 를 제공하는 서버 주소. 끝에 /v1 을 붙이지 않는다.
# (Claude Code 가 스스로 /v1/messages 를 붙인다.)
#   vLLM / SGLang / llama.cpp : http://host:8000
#   Ollama                    : http://host:11434
#   LiteLLM 프록시            : http://host:4000
export LLM_BASE_URL="http://1.233.219.134:4000"    # 연구실 LLM 서버의 LiteLLM 게이트웨이 (뒤에 GB10 노드 + 같은 호스트 llama.cpp). 구성원은 이것만 쓴다

# 인증 토큰. 서버가 인증을 안 하면 아무 문자열이나 넣는다(비우면 Claude Code 가 거부).
export LLM_API_KEY="none"      # LiteLLM 에 master_key 가 걸려 있으면 관리자가 준 키(sk-…). 인증 없는 서버면 아무 문자열. 빈 값은 안 된다

# 서버에 올라와 있는 모델 id. `llm-probe --models` 로 목록 확인.
export LLM_MODEL="qwen3.8-flash-next"   # GB10 우선 (대체: llama.cpp). qwen3.6-35b-a3b 는 llama.cpp 우선(느림) = 프로필 vega. 새 모델(예: GLM-5.3-Flash)이 등록되면 llm-probe --models 의 이름으로

# ── 호환성 조정 (보통 그대로) ─────────────────────────────────────────────
# 요청 하나가 쓸 수 있는 컨텍스트(토큰). Claude Code 는 모르는 모델을 200k 로 가정하므로 꼭 맞춘다.
# 실제보다 크면 서버가 400(exceed_context_size_error) 을 내고, 작으면 Claude Code 가 자동 압축을 반복한다("Autocompact is thrashing").
#   LiteLLM: llm-probe --models 가 모델 옆에 보여 준다.  llama.cpp: --ctx-size ÷ --parallel (--kv-unified 면 --ctx-size 전체).  vLLM/SGLang: --max-model-len.
export LLM_CONTEXT_WINDOW="262144"   # qwen3.8-flash-next (GB10). qwen3.6-35b-a3b 는 게이트웨이가 262144 를 광고해도 우선 백엔드 llama.cpp 가 131072 이므로 131072
# 모델이 지원하는 기능 선언 (쉼표 구분: effort,thinking,adaptive_thinking,interleaved_thinking).
# 비우면 Claude Code 가 모델명으로 추정. 서버가 thinking 관련 필드를 거부하면 "effort" 처럼 제한.
export LLM_CAPABILITIES=""
# 1 이면 서버가 모를 수 있는 anthropic-beta 필드를 보내지 않는다. 기본 1.
export LLM_DISABLE_BETAS=1
# 1 이면 prompt caching(cache_control) 을 끈다. 서버가 cache_control 로 400 을 내면 1.
export LLM_DISABLE_PROMPT_CACHING=0
# 사고 토큰 예산. 실측(Claude Code 2.1.312): 요청에 thinking={"type":"adaptive"}, effort=high 가 나가고 이 값은 무시된다.
# 모델이 스스로 사고량을 정하며(Qwen3.6 은 항상 사고), 서버가 thinking 필드로 400 을 낼 때만 0 을 넣어 끈다.
export LLM_MAX_THINKING_TOKENS=""

# ── 워커 세션 ─────────────────────────────────────────────────────────────
# 오케스트레이터가 "Ask @<이름> to ..." 로 부르는 이름.
export WORKER_NAME="llm-worker"
# 워커 성격. "" = 범용(실행·수집), "impl" = 구현 전용(시스템 프롬프트에 prompts/role-impl.md.tmpl 이 붙는다). install.sh --profile impl 이 넣는다.
export WORKER_ROLE=""

# ── 계산 backend: 기본은 현재 로컬 컴퓨터/WSL ─────────────────────────────
# 수치 계산·테스트는 기본적으로 이 컴퓨터의 CPU에서 실행한다.
# 위 LLM_BASE_URL은 모델 추론 서버이며 계산 backend 설정이 아니다.
# 아래 원격 노드는 프로젝트가 원격 계산을 명시적으로 요청할 때만 사용하는 선택 설정이다.
# ssh 별칭(~/.ssh/config 의 Host). 비워 두면 remote-* 명령과 프롬프트의 원격 절을 끈다.
export COMPUTE_HOST=""
# 원격 작업 디렉터리. 상대 경로면 원격 홈 기준. 프로젝트별로 <이 경로>/<프로젝트명> 이 생긴다.
export COMPUTE_WORK_DIR="claude-work"
# 프롬프트에 넣을 노드 설명 한 줄 (예: "RTX A6000 48GB x2, 503G RAM"). 비워도 된다.
export COMPUTE_DESC=""
