# Reference only: configure with ./install.sh. Never put a real API key here.
# URL/auth below are legacy installation inputs; gateway.env owns the runtime connection for all profiles.
export LLM_BASE_URL="http://1.233.219.161:4000"
export LLM_AUTH_MODE="none"
export LLM_API_KEY=""
export LLM_MODEL="deepseek-v4.1-flash"
export LLM_CONTEXT_WINDOW="262144"
export LLM_DISABLE_BETAS=1
export LLM_DISABLE_PROMPT_CACHING=0
export WORKER_NAME="deepseek-worker"
export WORKER_ROLE="implementer"
export COMPUTE_HOST=""
# Lab defaults: config/backend.defaults.json. Context is a conservative client budget; see docs/LAB_SERVER.md.
# Set LLM_AUTH_MODE=api_key and supply the key privately when the proxy requires authentication.
# Managed specs fix role, budgets and any explicit local/SSH compute job.
